# Copy to .env and fill in, OR pass inline:
#   PRIVATE_KEY=$(git config nostr.privkey) npm run deploy:testnet
#
# Hex private key (with or without 0x). This signs deploys/transactions.
PRIVATE_KEY=

# Optional RPC overrides (defaults are the public Rootstock nodes).
# RSK_TESTNET_RPC=https://public-node.testnet.rsk.co
# RSK_MAINNET_RPC=https://public-node.rsk.co
